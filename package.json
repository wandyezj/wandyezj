    "homepage": "https://github.com/wandyezj/wandyezj#readme",
    "dependencies": {
        
    },
    "devDependencies": {
        "html-webpack-plugin": "^5.6.8",
        "copy-webpack-plugin": "^14.0.0",
        "office-addin-dev-certs": "^2.0.10",
        "prettier": "^3.9.6",
        "ts-loader": "^9.5.1",
        "typescript": "^6.0.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0"
    }
}
