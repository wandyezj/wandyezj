{
    "name": "wandyezj",
    "version": "0.0.0",
    "description": "wandyezj.com website",
    "files": [
        "dist/*"
    ],
    "scripts": {
        "build": "webpack --config ./config/webpack.config.js --mode production",
        "start": "webpack serve --config ./config/webpack.config.js --mode development",
        "style": "prettier --config ./config/prettier.json  --write \"@(src|tests|scripts|config)/**/*.@(ts|tsx|js|md|html|css|json)\"",
        "style-check": "prettier --config ./config/prettier.json  --check \"@(src|tests|scripts)/**/*.@(ts|tsx|js|md|html|css|json)\"",
        "generate-icon": ".\\assets\\generate.cmd"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wandyezj/wandyezj.git"
    },
    "author": "wandyezj",
