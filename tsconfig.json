{
    "compilerOptions": {
      "allowJs": true,
      "experimentalDecorators": true,
      "jsx": "react",
      "noEmitOnError": true,
      "outDir": "lib",
      "sourceMap": true,
      "target": "es2024",
      "resolveJsonModule": true,
      "lib": [
        "es2015",
        "dom"
      ]
    },
    "exclude": [
      "node_modules",
      "dist",
      "lib",
      "lib-amd"
    ]
  }